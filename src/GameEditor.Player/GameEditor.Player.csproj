<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- publish = one exe: runtime, raylib.dll, assets and maps extracted on first run -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained Condition="'$(_IsPublishing)' == 'true'">true</SelfContained>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Raylib-cs" />
    <ProjectReference Include="..\GameEditor.Application\GameEditor.Application.csproj" />
    <ProjectReference Include="..\GameEditor.Infrastructure\GameEditor.Infrastructure.csproj" />
    <ProjectReference Include="..\GameEditor.Rendering\GameEditor.Rendering.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\**" LinkBase="assets" CopyToOutputDirectory="PreserveNewest" />
    <!-- exported maps: copy a .json saved by the editor here; publish only, so dotnet run plays the editor's Documents maps -->
    <!-- BundleMaps=false: the editor's bundled copy; Export puts the map next to the exe instead -->
    <None Update="maps\**" CopyToPublishDirectory="PreserveNewest" Condition="'$(BundleMaps)' != 'false'" />
  </ItemGroup>
</Project>
